{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KevinYoung-Kw/vibe-resume-skill/schema/resume.schema.json",
  "title": "Vibe Resume Data",
  "description": "Copy-paste resume facts for CN+EN campus and early-career job resumes. Agents collect this YAML, show it to the user, then apply it into an official template. Do not invent a layout from this file.",
  "type": "object",
  "additionalProperties": true,
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Candidate name as printed (中文或英文)."
    },
    "name_en": {
      "type": "string",
      "description": "Optional Latin / English name if `name` is Chinese."
    },
    "title": {
      "type": "string",
      "description": "意向岗位 / target role line, e.g. AI 产品经理 or Software Engineer Intern."
    },
    "major": {
      "type": "string",
      "description": "Optional header major, e.g. 软件工程 / Computer Science."
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "wechat": { "type": "string" },
        "location": { "type": "string", "description": "城市 / city, optional." },
        "website": { "type": "string" },
        "github": { "type": "string" },
        "portfolio": { "type": "string" }
      }
    },
    "summary": {
      "type": "string",
      "description": "个人介绍 / professional summary. 2–4 sentences. No fake metrics."
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/educationEntry" }
    },
    "experience": {
      "type": "array",
      "description": "实习经历 or 工作经历. Do not move internship work into projects.",
      "items": { "$ref": "#/$defs/experienceEntry" }
    },
    "projects": {
      "type": "array",
      "description": "项目经历 / 个人项目 / campus builds.",
      "items": { "$ref": "#/$defs/projectEntry" }
    },
    "skills": {
      "description": "核心能力. Either grouped objects or a flat string list.",
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/skillGroup" }
        },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "campus": {
      "type": "array",
      "description": "Optional 校园经历 / 社团 / 学生工作. Omit if empty.",
      "items": { "$ref": "#/$defs/projectEntry" }
    },
    "honors": {
      "type": "array",
      "description": "Optional awards. Prefer attaching small honors under education instead.",
      "items": { "type": "string" }
    },
    "languages": {
      "type": "array",
      "description": "Optional language ability, e.g. CET-6 540 / English working proficiency.",
      "items": { "type": "string" }
    },
    "certificates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "avatar": { "type": "string", "description": "Path or filename of color headshot." },
        "qr": { "type": "string", "description": "Path or filename of portfolio QR." },
        "qr_caption": { "type": "string" }
      }
    },
    "notes": {
      "type": "string",
      "description": "Private notes for the agent. Never print on the resume."
    }
  },
  "$defs": {
    "educationEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["school"],
      "properties": {
        "school": { "type": "string" },
        "school_en": { "type": "string" },
        "degree": { "type": "string", "description": "本科 / 硕士 / B.S. / M.S." },
        "major": { "type": "string" },
        "dates": { "type": "string", "description": "YYYY.MM - YYYY.MM or present / 至今." },
        "gpa": { "type": "string", "description": "e.g. 3.8/5.0 or 3.7/4.0." },
        "rank": { "type": "string", "description": "e.g. 专业前10%." },
        "honors": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "experienceEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["org", "role"],
      "properties": {
        "org": { "type": "string", "description": "Company or team name." },
        "org_en": { "type": "string" },
        "role": { "type": "string" },
        "dates": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["internship", "full-time", "part-time", "research"],
          "description": "internship → 实习经历; full-time → 工作经历."
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/workItem" }
        }
      }
    },
    "projectEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "name_en": { "type": "string" },
        "subtitle": { "type": "string" },
        "role": { "type": "string" },
        "dates": { "type": "string" },
        "link": { "type": "string" },
        "bullets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "skillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "items"],
      "properties": {
        "label": { "type": "string", "description": "e.g. AI 产品 / 数据工具 / Languages." },
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
